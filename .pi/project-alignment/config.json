{
  "schemaVersion": 1,
  "enabled": true,
  "analysis": {
    "maxDeepDiveFeatures": 8,
    "maxFilesPerFeature": 15,
    "maxCallDepth": 5,
    "maxEvidencePasses": 2
  },
  "criticalDomains": [
    "authentication",
    "authorization",
    "payment",
    "data-deletion",
    "privacy",
    "irreversible"
  ],
  "persistence": {
    "confirmedOnly": true,
    "temporaryRetentionDays": 7
  }
}
